            ],
            "url": {
              "raw": "{{base_url}}/insights?month_period=2026-05",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "insights"
              ],
              "query": [
                {
                  "key": "month_period",
                  "value": "2026-05"
                }
              ]
            }
          }
        },
        {
          "name": "Data Export for DS Streamlit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/export/streamlit?USERID=uuid-123&START=2026_05_01&END=2026_05_19",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "export",
                "streamlit"
              ],
              "query": [
                {
                  "key": "USERID",
                  "value": "uuid-123"
                },
                {
                  "key": "START",
                  "value": "2026_05_01"
                },
                {
                  "key": "END",
                  "value": "2026_05_19"
                }
              ]
            }
          }
        }
